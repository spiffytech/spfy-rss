# Copy to .env for local runs. Bun loads it automatically from the cwd; the
# production deployment gets these from compose instead.

# Required in production: HMAC key for session cookies.
SESSION_SECRET=

# Where the SQLite database lives. Runtime flags (.scheduler-off,
# .scheduler-heartbeat) are written beside it.
READER_DB_PATH=data/reader.sqlite

PORT=5173

# Self-service registration. Off when 0.
ALLOW_SIGNUP=1

# Public origin WebSub hubs POST back to. Empty disables WebSub.
READER_PUBLIC_URL=

# 0 pauses the poll loop, same as the .scheduler-off flag file.
SCHEDULER_ENABLED=1

# Fastest/slowest per-feed poll, in minutes.
SCHEDULER_ENTRY_FREQUENCY_MIN_INTERVAL=5
SCHEDULER_ENTRY_FREQUENCY_MAX_INTERVAL=1440
# Multiplies expected items/day when sizing intervals.
SCHEDULER_ENTRY_FREQUENCY_FACTOR=1

# Publish-rate learning window, and the half-life of the item-rate average.
SCHEDULER_LEARNING_WINDOW_DAYS=90
SCHEDULER_RATE_HALF_LIFE_DAYS=7

# Ceiling for failing-feed probe backoff (minutes).
SCHEDULER_FAILING_FEED_MAX_INTERVAL_MINUTES=10080
# /health/scheduler answers 503 once no loop completed within this many minutes.
SCHEDULER_MAX_TICK_AGE_MINUTES=5

# Skip feeds whose parsing_error_count is at or above this. 0 = never skip.
POLLING_PARSING_ERROR_LIMIT=0

# ntfy topic URL for scheduler alerts. Empty disables them.
SCHEDULER_NTFY_URL=

# One-shot Miniflux import only (scripts/import-miniflux.ts dump); never commit.
MINIFLUX_DATABASE_URL=
IMPORT_DIR=import-dump
