{
  "name": "reader-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun run --parallel --no-exit-on-error dev:web dev:worker dev:css",
    "dev:web": "bun --bun vite dev",
    "dev:worker": "bun --watch src/startup-cli.ts",
    "dev:css": "bun run build:css -- --watch",
    "build": "bun run build:css && bun --bun vite build",
    "build:css": "bunx @tailwindcss/cli -i ./src/app.css -o ./public/style.css",
    "start": "bun server.ts",
    "preview": "bun run build && bun server.ts",
    "test": "bun test",
    "test:webview": "bun run build && WEBVIEW=1 bun test test/webview.test.ts",
    "test:dev": "WEBVIEW=1 bun test test/dev-smoke.test.ts",
    "typecheck": "bunx --bun tsc --noEmit",
    "lint": "oxlint .",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "check": "bun run typecheck && bun run test",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@solidjs/router": "2.0.0-next.43",
    "@solidjs/web": "2.0.0-rc.21",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45.4",
    "feedsmith": "^3.0.1",
    "lite-youtube-embed": "^0.3.4",
    "solid-js": "2.0.0-rc.21",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.56",
    "@tailwindcss/cli": "^4.3.4",
    "@types/bun": "^1.4.4",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.91.0",
    "tailwindcss": "^4.3.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "8.3.5"
  }
}
